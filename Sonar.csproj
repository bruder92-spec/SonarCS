<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Sonar</AssemblyName>
    <RootNamespace>Sonar</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Version>2.3.0</Version>
    <Copyright>Copyright © 2026 Varzakov Stanislav</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio"                   Version="2.2.1"  />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>

  <!-- Документация и лицензии сторонних компонентов. -->
  <ItemGroup>
    <None Include="NOTICES.txt"  CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="!readme.txt"  CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>

<!-- GigaAM v3 e2e model (215 MB) + vocabulary. Conditional: build does not fail if files are absent. -->
  <!-- Model: https://huggingface.co/istupakov/gigaam-v3-onnx/resolve/main/v3_e2e_ctc.int8.onnx -->
  <!-- Vocab:  https://huggingface.co/istupakov/gigaam-v3-onnx/resolve/main/v3_e2e_ctc_vocab.txt  -->
  <ItemGroup>
    <None Condition="Exists('giga-am-v3.onnx')"       Include="giga-am-v3.onnx"       CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Condition="Exists('giga-am-v3-vocab.txt')"  Include="giga-am-v3-vocab.txt"  CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <!-- Папка user/ — все пользовательские файлы: словари замен и голосовые команды. -->
  <ItemGroup>
    <None Condition="Exists('user\dictionary_oil_gas.txt')" Include="user\dictionary_oil_gas.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Condition="Exists('user\dictionary_legal.txt')"   Include="user\dictionary_legal.txt"   CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Condition="Exists('user\dictionary_economy.txt')" Include="user\dictionary_economy.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Condition="Exists('user\dictionary_user.txt')"    Include="user\dictionary_user.txt"    CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Condition="Exists('user\commands_user.txt')"    Include="user\commands_user.txt"    CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>

</Project>
