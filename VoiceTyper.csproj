<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VoiceTyper</AssemblyName>
    <RootNamespace>VoiceTyper</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio"                               Version="2.2.1"   />
    <PackageReference Include="Vosk"                                 Version="0.3.38"  />
    <PackageReference Include="Whisper.net"                          Version="1.9.0"   />
    <PackageReference Include="Whisper.net.Runtime"                  Version="1.9.0"   />
    <PackageReference Include="Whisper.net.Runtime.Vulkan"           Version="1.9.0"   />
    <PackageReference Include="org.k2fsa.sherpa.onnx"                Version="1.12.40" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="1.12.40" />
  </ItemGroup>

  <!-- VC++ runtime DLLs, required by whisper.dll (MSVC-compiled). -->
  <!-- Pre-installed on most Windows 10/11 systems, but included here for guaranteed offline portability. -->
  <ItemGroup>
    <None Include="vcredist\vcruntime140.dll"   CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="vcredist\vcruntime140_1.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="vcredist\MSVCP140.dll"       CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <!-- GigaAM v2 model files for sherpa-onnx engine (226 MB + 196 B). -->
  <ItemGroup>
    <None Include="giga-am-v2.onnx"      CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="giga-am-tokens.txt"   CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>

</Project>
