<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VoiceTyper</AssemblyName>
    <RootNamespace>VoiceTyper</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio"                               Version="2.2.1"   />
    <PackageReference Include="Vosk"                                 Version="0.3.38"  />
    <PackageReference Include="Whisper.net"                          Version="1.9.0"   />
    <PackageReference Include="Whisper.net.Runtime"                  Version="1.9.0"   />
    <PackageReference Include="Whisper.net.Runtime.Vulkan"           Version="1.9.0"   />
    <PackageReference Include="Microsoft.ML.OnnxRuntime"             Version="1.20.1"  />
  </ItemGroup>

  <!-- VC++ runtime DLLs, required by whisper.dll (MSVC-compiled). -->
  <!-- Pre-installed on most Windows 10/11 systems, but included here for guaranteed offline portability. -->
  <ItemGroup>
    <None Include="vcredist\vcruntime140.dll"   CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="vcredist\vcruntime140_1.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="vcredist\MSVCP140.dll"       CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <!-- GigaAM v3 model (225 MB). Conditional: build does not fail if file is absent. -->
  <!-- Download: https://huggingface.co/istupakov/gigaam-v3-onnx/resolve/main/v3_ctc.int8.onnx -->
  <!-- Then rename to giga-am-v3.onnx and place next to VoiceTyper.exe (or in VoiceTyperCS\ for publish). -->
  <ItemGroup>
    <None Condition="Exists('giga-am-v3.onnx')" Include="giga-am-v3.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>

</Project>
